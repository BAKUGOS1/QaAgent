{
  "name": "qa-agent",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "TypeScript + Playwright QA agent for safe website testing, browser-state capture, and Markdown/JSON/Excel reports.",
  "type": "module",
  "keywords": [
    "qa",
    "qa-agent",
    "playwright",
    "typescript",
    "browser-automation",
    "web-testing",
    "test-automation",
    "codex",
    "groq",
    "crm-testing"
  ],
  "homepage": "https://github.com/BAKUGOS1/QaAgent#readme",
  "bugs": {
    "url": "https://github.com/BAKUGOS1/QaAgent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BAKUGOS1/QaAgent.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "agent": "tsx agent/src/index.ts",
    "agent:codex": "tsx agent/src/index.ts --mode codex",
    "agent:api": "tsx agent/src/index.ts --mode groq",
    "agent:headed": "tsx agent/src/index.ts --headed",
    "agent:task": "tsx agent/src/index.ts --task-file",
    "agent:state": "tsx agent/src/index.ts --mode codex --state-only",
    "test:agent": "playwright test",
    "test:smoke": "tsx agent/tests/smoke.ts",
    "quality:gate": "tsx agent/scripts/quality-gate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "playwright": "^1.57.0",
    "tsx": "^4.21.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
