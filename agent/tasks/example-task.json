{
  "websiteUrl": "https://example.com",
  "task": "Open the website, capture a screenshot, inspect visible text, console errors, network errors, and generate a QA report.",
  "qaProfile": "smoke",
  "testDataCount": 3,
  "scope": ["smoke", "navigation", "console", "network", "screenshot"],
  "safety": {
    "allowDelete": false,
    "allowArchive": false,
    "allowPayment": false,
    "allowRealMessageSend": false,
    "allowBulkUpdate": false,
    "allowSettingsChange": false,
    "allowSensitiveExport": false
  },
  "cypress": {
    "defaultCommandTimeoutMs": 5000,
    "pollIntervalMs": 100,
    "screenshotOnFailure": true
  },
  "steps": [
    { "action": "screenshot", "label": "example-home" },
    { "action": "assert_text", "expected": "Example Domain", "label": "homepage headline" },
    { "action": "assert_visible", "selector": "h1", "label": "headline visible" },
    { "action": "assert_url_includes", "expected": "example.com", "label": "url contains domain" },
    { "action": "assert_count", "selector": "h1", "count": 1, "label": "one h1" },
    { "action": "analyze", "label": "analyze homepage" }
  ]
}
